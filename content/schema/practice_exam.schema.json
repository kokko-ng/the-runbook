{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-runbook.dev/schema/practice_exam.schema.json",
  "title": "Practice exam",
  "description": "One practice exam. Written by a language model, labeled as such, and grounded question by question in learn.microsoft.com.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "exam", "number", "title", "author", "model_id", "written_on", "questions"],
  "properties": {
    "id": {"type": "string", "pattern": "^az-\\d{3}-[1-9]$"},
    "exam": {"type": "string", "pattern": "^AZ-\\d{3}$"},
    "number": {"type": "integer", "minimum": 1, "maximum": 9},
    "title": {"type": "string", "minLength": 1},
    "author": {"const": "Opus 5.5"},
    "model_id": {"const": "claude-opus-5-5"},
    "written_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "skill", "kind", "stem", "options", "answer", "explanation", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^q\\d{2}$"},
          "domain": {"type": "string", "pattern": "^AZ\\d{3}-\\d+$"},
          "skill": {"type": "string", "minLength": 1},
          "kind": {"enum": ["single", "multiple"]},
          "stem": {"type": "string", "minLength": 20},
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-f]$"},
                "text": {"type": "string", "minLength": 1}
              }
            }
          },
          "answer": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-f]$"}
          },
          "explanation": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^https://learn\\.microsoft\\.com/en-us/[^\\s]+$"}
          }
        }
      }
    }
  }
}
