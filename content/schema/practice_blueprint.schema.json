{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-runbook.dev/schema/practice_blueprint.schema.json",
  "title": "Practice exam blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exam", "title", "study_guide_url", "skills_measured_as_of", "time_limit_minutes",
    "passing_percent", "domains"
  ],
  "properties": {
    "exam": {"type": "string", "pattern": "^AZ-\\d{3}$"},
    "title": {"type": "string", "minLength": 1},
    "study_guide_url": {"type": "string", "pattern": "^https://learn\\.microsoft\\.com/"},
    "skills_measured_as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "time_limit_minutes": {"type": "integer", "minimum": 10, "maximum": 240},
    "passing_percent": {"type": "integer", "minimum": 1, "maximum": 100},
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "weight", "questions", "groups"],
        "properties": {
          "id": {"type": "string", "pattern": "^AZ\\d{3}-\\d+$"},
          "title": {"type": "string", "minLength": 1},
          "weight": {"type": "string", "pattern": "^\\d+-\\d+%$"},
          "questions": {"type": "integer", "minimum": 1},
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "skills"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
