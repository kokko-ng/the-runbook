{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-runbook.dev/schema/world.schema.json",
  "title": "World bible",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "ranks", "cast", "acts", "chapters"],
  "properties": {
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "descriptor", "headquarters", "footprint", "primary_region", "secondary_region", "tenant"],
      "properties": {
        "name": {"type": "string"},
        "descriptor": {"type": "string"},
        "headquarters": {"type": "string"},
        "footprint": {"type": "string"},
        "primary_region": {"type": "string"},
        "secondary_region": {"type": "string"},
        "tenant": {"type": "string"}
      }
    },
    "ranks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string"}
        }
      }
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "note"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string"},
          "role": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "exam", "title", "tagline", "chapters"],
        "properties": {
          "id": {"type": "string", "pattern": "^act[12]$"},
          "number": {"type": "integer"},
          "exam": {"enum": ["AZ-104", "AZ-305"]},
          "title": {"type": "string"},
          "tagline": {"type": "string"},
          "chapters": {"type": "array", "items": {"type": "string", "pattern": "^act[12]-[a-z0-9-]+$"}}
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "act", "order", "domain", "title", "rank", "blurb"],
        "properties": {
          "id": {"type": "string", "pattern": "^act[12]-[a-z0-9-]+$"},
          "act": {"type": "string", "pattern": "^act[12]$"},
          "order": {"type": "integer", "minimum": 1},
          "domain": {"type": "string", "pattern": "^AZ(104|305)-\\d+$"},
          "title": {"type": "string"},
          "rank": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "blurb": {"type": "string"}
        }
      }
    }
  }
}
